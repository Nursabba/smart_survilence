

import streamlit as st
from streamlit_webrtc import webrtc_streamer, VideoProcessorBase
from ultralytics import YOLO
import av, cv2, csv, os, time
from datetime import datetime

st.set_page_config(page_title="AI Smart Surveillance", layout="wide")
st.title("AI Smart Surveillance System")

model = YOLO("yolov8n.pt")
os.makedirs("captures", exist_ok=True)
os.makedirs("recordings", exist_ok=True)
log_file="surveillance_log.csv"
if not os.path.exists(log_file):
    with open(log_file,"w",newline="") as f:
        csv.writer(f).writerow(["Time","Persons","Cars","Bikes","Alert"])

RX1,RY1,RX2,RY2=180,120,460,420
last_capture=0

class Surveillance(VideoProcessorBase):
    def recv(self, frame):
        global last_capture
        img=frame.to_ndarray(format="bgr24")
        img=cv2.resize(img,(640,480))
        results=model(img,verbose=False)[0]
        persons=cars=bikes=0
        alert="NORMAL"
        cv2.rectangle(img,(RX1,RY1),(RX2,RY2),(0,0,255),2)
        cv2.putText(img,"Restricted Zone",(RX1,RY1-8),cv2.FONT_HERSHEY_SIMPLEX,0.6,(0,0,255),2)
        for box in results.boxes:
            cls=int(box.cls[0]); conf=float(box.conf[0])
            x1,y1,x2,y2=map(int,box.xyxy[0]); cx,cy=(x1+x2)//2,(y1+y2)//2
            if cls==0: persons+=1; label="Person"; color=(0,255,0)
            elif cls==2: cars+=1; label="Car"; color=(255,0,0)
            elif cls==3: bikes+=1; label="Bike"; color=(0,255,255)
            elif cls==67: label="Phone"; color=(255,0,255)
            elif cls==73: label="Book"; color=(128,255,0)
            elif cls==63: label="Laptop"; color=(255,165,0)
            else: continue
            cv2.rectangle(img,(x1,y1),(x2,y2),color,2)
            cv2.circle(img,(cx,cy),3,color,-1)
            cv2.putText(img,f"{label} {conf:.2f}",(x1,max(18,y1-8)),cv2.FONT_HERSHEY_SIMPLEX,0.5,color,2)
            if cls==0 and RX1<cx<RX2 and RY1<cy<RY2:
                alert="INTRUSION ALERT"
        now=datetime.now().strftime("%d-%m-%Y %H:%M:%S")
        with open(log_file,"a",newline="") as f:
            csv.writer(f).writerow([now,persons,cars,bikes,alert])
        if alert=="INTRUSION ALERT" and time.time()-last_capture>5:
            cv2.imwrite(f"captures/{datetime.now().strftime('%Y%m%d_%H%M%S')}.jpg",img)
            last_capture=time.time()
        cv2.rectangle(img,(0,0),(640,95),(30,30,30),-1)
        cv2.putText(img,now,(10,18),cv2.FONT_HERSHEY_SIMPLEX,0.5,(255,255,255),1)
        cv2.putText(img,"FPS : 30",(10,38),cv2.FONT_HERSHEY_SIMPLEX,0.6,(255,255,0),2)
        cv2.putText(img,f"Person:{persons} Car:{cars} Bike:{bikes}",(10,60),cv2.FONT_HERSHEY_SIMPLEX,0.6,(0,255,255),2)
        cv2.putText(img,alert,(10,82),cv2.FONT_HERSHEY_SIMPLEX,0.7,(0,255,0) if alert=="NORMAL" else (0,0,255),2)
        return av.VideoFrame.from_ndarray(img,format="bgr24")

webrtc_streamer(
    key="surveillance",
    video_processor_factory=Surveillance,
    media_stream_constraints={"video":True,"audio":False},
    async_processing=True
)
